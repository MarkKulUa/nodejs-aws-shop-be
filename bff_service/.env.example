# Port the BFF Service listens on
PORT=3000

# Recipient service mappings.
# The key equals the {recipient-service-name} used in the URL:
#   {bff-url}/{recipient-service-name}/...  ->  forwarded to this base URL
# Example: GET {bff-url}/product/products      -> {product}/products
#          GET {bff-url}/cart/api/profile/cart -> {cart}/api/profile/cart
product=https://jspv7v2wu9.execute-api.eu-west-1.amazonaws.com/prod
cart=http://MarkKulUa-cart-api-prod.eu-west-1.elasticbeanstalk.com

# getProductsList cache (BFF level).
# CACHE_ENABLED  - set to "false" to disable caching (default: enabled)
# CACHE_TTL_MS   - cache lifetime in ms (default: 120000 = 2 minutes)
# CACHE_REST_PATH- rest path (after the service name) whose GET is cached
CACHE_ENABLED=true
CACHE_TTL_MS=120000
CACHE_REST_PATH=products
